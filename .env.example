# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY=""

# APP_URL: Public URL where this applet is hosted (used for delivery report callbacks).
APP_URL="https://your-applet-domain.run.app"

# AFRICASTALKING_API_KEY: Sandbox API key from Africa's Talking dashboard
# Get it at: https://account.africastalking.com -> Sandbox -> Settings -> API Key
AFRICASTALKING_API_KEY=""

# AFRICASTALKING_USERNAME: 'sandbox' for sandbox environment
AFRICASTALKING_USERNAME="sandbox"

# SHOPKEEPER_PHONE: Default phone number for owner alerts (+2547XXXXXXXX)
SHOPKEEPER_PHONE="+254712345678"

# SHOP_NAME: Business name displayed in SMS messages
SHOP_NAME="Mama Boi Duka"

